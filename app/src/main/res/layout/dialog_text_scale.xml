<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/dp40">

        <TextView
            android:id="@+id/tvPreview"
            style="@style/TextStyle.Black.24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/dp24"
            android:text="@string/text_scale_preview" />

        <TextView
            style="@style/TextStyle.Grey.20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/dp12"
            android:text="@string/text_scale_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/dp24">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnTextMinus"
                style="@style/ButtonStyleBlack"
                android:layout_width="wrap_content"
                android:minWidth="@dimen/dp80"
                android:text="@string/text_scale_minus" />

            <TextView
                android:id="@+id/tvTextScaleLabel"
                style="@style/TextStyle.Black.24"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnTextPlus"
                style="@style/ButtonStyleBlack"
                android:layout_width="wrap_content"
                android:minWidth="@dimen/dp80"
                android:text="@string/text_scale_plus" />
        </LinearLayout>

        <TextView
            style="@style/TextStyle.Grey.20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/dp12"
            android:text="@string/ui_scale_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/dp24">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnUiMinus"
                style="@style/ButtonStyleBlack"
                android:layout_width="wrap_content"
                android:minWidth="@dimen/dp80"
                android:text="@string/ui_scale_minus" />

            <TextView
                android:id="@+id/tvUiScaleLabel"
                style="@style/TextStyle.Black.24"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnUiPlus"
                style="@style/ButtonStyleBlack"
                android:layout_width="wrap_content"
                android:minWidth="@dimen/dp80"
                android:text="@string/ui_scale_plus" />
        </LinearLayout>

        <TextView
            style="@style/TextStyle.Grey.20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/dp12"
            android:text="@string/theme_title" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnTheme"
            style="@style/ButtonStyleBlackBig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/btn_primary_height" />

    </LinearLayout>
</ScrollView>
