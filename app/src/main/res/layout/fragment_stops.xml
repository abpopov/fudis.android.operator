<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/dp60"
    android:layout_marginTop="@dimen/dp20"
    android:layout_marginEnd="@dimen/dp60"
    android:layout_marginBottom="@dimen/dp60"
    android:background="@drawable/ic_bg_rounded_bl05_32">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrganization"
        style="@style/EditStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp60"
        android:layout_marginTop="@dimen/dp48"
        android:layout_marginEnd="@dimen/dp60"
        android:background="@drawable/ic_bg_rounded_wh_12"
        android:drawableEnd="@drawable/ic_chevron_big_down"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:hint="@string/pause_org_hint"
        android:minHeight="@dimen/dp64"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etSearch"
        style="@style/EditStyle"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp64"
        android:layout_marginStart="@dimen/dp60"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp60"
        android:background="@drawable/ic_bg_rounded_wh_12"
        android:elevation="2dp"
        android:hint="@string/stops_search_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvOrganization" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClear"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp64"
        android:background="@drawable/ic_bg_rounded_tr_12_ripple"
        android:elevation="2dp"
        android:padding="@dimen/dp20"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/etSearch"
        app:layout_constraintTop_toTopOf="@+id/etSearch"
        app:srcCompat="@drawable/ic_close_24_g" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStopList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dp60"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp60"
        android:layout_marginBottom="@dimen/dp24"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/tvApply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSearch"
        tools:listitem="@layout/list_item_highload" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvEmpty"
        style="@style/TextStyle.Grey.24"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/stops_empty"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/tvApply"
        app:layout_constraintEnd_toEndOf="@+id/rvStopList"
        app:layout_constraintStart_toStartOf="@+id/rvStopList"
        app:layout_constraintTop_toBottomOf="@+id/etSearch" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvReload"
        style="@style/ButtonStyleBlackBig"
        android:layout_width="wrap_content"
        android:elevation="2dp"
        android:text="@string/stops_reload"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/tvApply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSearch" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvApply"
        style="@style/ButtonStyleGreen"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/dp60"
        android:layout_marginEnd="@dimen/dp60"
        android:layout_marginBottom="@dimen/dp48"
        android:elevation="2dp"
        android:text="@string/stops_apply"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
